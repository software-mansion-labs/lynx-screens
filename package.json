{
  "name": "lynx-screens",
  "version": "1000.0.0",
  "description": "Native stack navigation primitives for Lynx, modeled after react-native-screens",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/software-mansion-labs/lynx-screens.git"
  },
  "homepage": "https://github.com/software-mansion-labs/lynx-screens#readme",
  "bugs": {
    "url": "https://github.com/software-mansion-labs/lynx-screens/issues"
  },
  "type": "module",
  "main": "./src/index.ts",
  "files": [
    "android/src/main",
    "android/src/formSheetMaterial",
    "android/src/formSheetExternal",
    "android/build.gradle.kts",
    "ios",
    "src",
    "lynx.lib.json",
    "README.md"
  ],
  "scripts": {
    "codegen": "lynx-autolink-codegen",
    "format": "prettier --write .",
    "lint": "eslint .",
    "typecheck": "tsc"
  },
  "peerDependencies": {
    "@lynx-js/react": "*"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@lynx-js/autolink-codegen": "^0.5.0",
    "@lynx-js/react": "^0.126.0",
    "@lynx-js/types": "^4.2.1",
    "@types/react": "~19.2.17",
    "eslint": "^9.32.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "prettier": "^3.6.2",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.38.0"
  },
  "engines": {
    "node": ">=18"
  }
}
